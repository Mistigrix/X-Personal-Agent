# -----------------------------------------------------------------------------
# x-personal-agent — environment variables
#
# Copy to `.env` (or run `pnpm init:local`) and fill in your own values.
# `.env` is gitignored: never commit real credentials. Behaviour settings live in
# local/agent.yaml, not here. Empty values are treated as "not set".
# -----------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
# development | production | test
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# json (production) | pretty (human-readable; needs dev dependencies installed)
LOG_FORMAT=pretty

# Paths are relative to the project root.
APP_CONFIG_PATH=./local/agent.yaml
DATABASE_PATH=./local/data/agent.db

# dry-run (default): nothing is ever sent to X; publications are simulated.
# live: posts are really published. Requires the X_* credentials below.
PUBLISH_MODE=dry-run

# --- Telegram (required) -------------------------------------------------------
# Create a bot with @BotFather and paste its token (format: 123456789:AA...).
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to control the bot.
# Run `pnpm telegram:whoami` (available from Milestone 2) to find yours.
TELEGRAM_ALLOWED_USER_IDS=

# --- OpenAI (required when ai.enabled is true in local/agent.yaml) ------------
OPENAI_API_KEY=

# --- X API, OAuth 1.0a user context (required when PUBLISH_MODE=live) ---------
# From your app in the X Developer Console. Set the app permissions to
# "Read and write" BEFORE generating the access token and secret.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

{
  "name": "x-personal-agent",
  "version": "0.1.0",
  "description": "Self-hosted agent that publishes your own posts on X and drafts AI posts for your explicit approval, driven from a private Telegram bot.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "typecheck": "tsc",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.ts",
    "init:local": "node scripts/init-local.ts",
    "check:secrets": "node scripts/check-secrets.ts",
    "telegram:whoami": "node scripts/telegram-whoami.ts",
    "schedule:preview": "node scripts/schedule-preview.ts",
    "x:verify": "node scripts/x-verify.ts"
  },
  "dependencies": {
    "@xdevplatform/xdk": "0.6.6",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.46.0",
    "luxon": "^3.7.2",
    "pino": "^10.4.0",
    "twitter-text": "^3.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "@types/twitter-text": "^3.1.10",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
